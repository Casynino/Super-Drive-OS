# Copy to .env and fill in. Never commit .env.
# The address the APP uses. On Neon use the POOLED address (the host contains "-pooler"), with ?sslmode=require.
DATABASE_URL="postgresql://USER@localhost:5432/superdrive_dev"

# Optional: the DIRECT (unpooled) Neon address. `prisma migrate deploy` and the seed use it when it is set; leave it out on a laptop.
# DIRECT_URL=

# Used ONLY by `npm run db:seed` to create the first Super Admin when no users exist.
ADMIN_NAME="Business Owner"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# WhatsApp daily report (CallMeBot). Server-side secrets: never put these in client code.
# CALLMEBOT_API_KEY comes from callmebot.com after you link your WhatsApp number.
# CRON_SECRET is a long random value (16+ characters); the scheduler sends it as "Authorization: Bearer <value>".
CALLMEBOT_API_KEY=
CRON_SECRET=

# The web address of the app, used for links inside WhatsApp reports (no trailing slash).
APP_URL=
