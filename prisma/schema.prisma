// Super Drive Oil - Phase 1 schema (foundation + catalog).
// Conventions:
//  - Money: Decimal(14,2). Quantities: Decimal(14,3). Unit factors: Decimal(14,4).
//  - Stock is ALWAYS stored in the product's base unit. Other units convert via ProductUnit.factor.
//  - Nothing here is hard-deleted by the app: records are deactivated (status) instead.
//  - Extra DB-level guards (CHECK constraints, single default location, immutable audit log)
//    live in the init migration SQL because Prisma cannot express them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  WAREHOUSE
  SHOP
  OTHER
  RESELLER // stock held by a reseller (custody): still ours, but not available on the shop shelf
}

// ───────────── Access control ─────────────

model Role {
  id           String           @id @default(cuid())
  key          String           @unique // stable identifier, e.g. SUPER_ADMIN
  name         String
  description  String?
  isSystem     Boolean          @default(false) // built-in roles cannot be deleted
  isSuperAdmin Boolean          @default(false) // always has every permission (lock-out protection)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  users        User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. products.create
  module      String
  label       String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                  String                  @id @default(cuid())
  username            String                  @unique // stored lowercase
  name                String
  email               String?                 @unique
  phone               String?
  passwordHash        String
  roleId              String
  role                Role                    @relation(fields: [roleId], references: [id])
  status              RecordStatus            @default(ACTIVE)
  mustChangePassword  Boolean                 @default(false)
  failedLoginCount    Int                     @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  stockMovements      StockMovement[]
  stockReceipts       StockReceipt[]
  stockTransfers      StockTransfer[]
  stockAdjustments    StockAdjustment[]
  sales               Sale[]                  @relation("SaleSalesperson")
  creditApprovals     Sale[]                  @relation("SaleCreditApprover")
  paymentsReceived    Payment[]
  customersCreated    Customer[]
  creditApplications  CreditApplication[]
  notifications       Notification[]
  shipmentsCreated    Shipment[]              @relation("ShipmentCreator")
  shipmentsResolved   Shipment[]              @relation("ShipmentResolver")
  shipmentsClosed     Shipment[]              @relation("ShipmentCloser")
  shipmentsArrived    Shipment[]              @relation("ShipmentArriver")
  receivingsStarted   ShipmentReceiving[]     @relation("ReceivingStarter")
  receivingsConfirmed ShipmentReceiving[]     @relation("ReceivingConfirmer")
  reversalsRequested  SaleReversal[]          @relation("ReversalRequester")
  reversalsDecided    SaleReversal[]          @relation("ReversalDecider")
  cashTransactions    CashTransaction[]
  expensesRequested   Expense[]               @relation("ExpenseRequester")
  expensesDecided     Expense[]               @relation("ExpenseDecider")
  expensesReversed    Expense[]               @relation("ExpenseReverser")
  bankDeposits        BankDeposit[]
  itemMovements       ItemMovement[]
  closingsSubmitted   DailyClosing[]          @relation("ClosingSubmitter")
  closingsReviewed    DailyClosing[]          @relation("ClosingReviewer")
  attachments         Attachment[]
  resellersCreated    Reseller[]
  resellerIssues      ResellerIssue[]
  resellerReturns     ResellerReturn[]
  supplierPayments    SupplierPayment[]
  issuesDecided       ShipmentIssueDecision[] @relation("IssueDecider")
  pickupsCreated      PickupNote[]            @relation("PickupCreator")
  pickupsStarted      PickupNote[]            @relation("PickupStarter")
  pickupsReady        PickupNote[]            @relation("PickupReadier")
  pickupsCompleted    PickupNote[]            @relation("PickupCompleter")
  pickupsCancelled    PickupNote[]            @relation("PickupCanceller")
  pickupReleases      PickupRelease[]
  warehouseEvents     WarehouseEvent[]

  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of the cookie token; the raw token is never stored
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

// ───────────── Business setup ─────────────

model Location {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String       @unique
  type      LocationType @default(WAREHOUSE)
  address   String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  // true = sales from this location RESERVE the stock and make a pickup note; the stock leaves only when the goods are released (Store Warehouse)
  pickupRequired Boolean  @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pickupNotes         PickupNote[]
  warehouseEvents     WarehouseEvent[]
  balances            StockBalance[]
  movements           StockMovement[]
  receipts            StockReceipt[]
  transfersOut        StockTransfer[]   @relation("TransferFrom")
  transfersIn         StockTransfer[]   @relation("TransferTo")
  adjustments         StockAdjustment[]
  sales               Sale[]
  shipments           Shipment[]
  items               InventoryItem[]
  cashAccounts        CashAccount[]
  expenses            Expense[]
  bankDeposits        BankDeposit[]
  closings            DailyClosing[]
  reseller            Reseller?
  resellerIssuesFrom  ResellerIssue[]   @relation("IssueFrom")
  resellerIssuesTo    ResellerIssue[]   @relation("IssueTo")
  resellerReturnsFrom ResellerReturn[]  @relation("ReturnFrom")
  resellerReturnsTo   ResellerReturn[]  @relation("ReturnTo")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ───────────── Catalog ─────────────

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
}

model Brand {
  id        String       @id @default(cuid())
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  Product[]
}

model Unit {
  id                  String                  @id @default(cuid())
  name                String                  @unique // Litre
  symbol              String                  @unique // L
  allowsDecimal       Boolean                 @default(false) // litres: true, pieces/cartons: false
  status              RecordStatus            @default(ACTIVE)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  baseProducts        Product[]
  productUnits        ProductUnit[]
  receiptItems        StockReceiptItem[]
  transferItems       StockTransferItem[]
  adjustItems         StockAdjustmentItem[]
  saleItems           SaleItem[]
  shipmentItems       ShipmentItem[]
  resellerIssueItems  ResellerIssueItem[]
  resellerReturnItems ResellerReturnItem[]
  receivingItems      ShipmentReceivingItem[]
  salesDefaultFor     Product[]               @relation("ProductDefaultSalesUnit")
  purchaseDefaultFor  Product[]               @relation("ProductDefaultPurchaseUnit")
}

model Product {
  id                    String                  @id @default(cuid())
  sku                   String                  @unique // stored uppercase
  barcode               String?                 @unique
  name                  String
  description           String?
  categoryId            String
  category              Category                @relation(fields: [categoryId], references: [id])
  brandId               String?
  brand                 Brand?                  @relation(fields: [brandId], references: [id])
  packagingType         String?
  size                  String? // e.g. "5L"; shown on labels
  baseUnitId            String
  baseUnit              Unit                    @relation(fields: [baseUnitId], references: [id])
  // Carton-first: the unit shown and typed by default (usually the carton). Stock is still kept in the base unit; these only choose what people see first.
  defaultSalesUnitId    String?
  defaultSalesUnit      Unit?                   @relation("ProductDefaultSalesUnit", fields: [defaultSalesUnitId], references: [id])
  defaultPurchaseUnitId String?
  defaultPurchaseUnit   Unit?                   @relation("ProductDefaultPurchaseUnit", fields: [defaultPurchaseUnitId], references: [id])
  allowPieceSales       Boolean                 @default(true) // false = this product can only be sold in its packs (cartons), never as single pieces
  purchasePrice         Decimal                 @db.Decimal(14, 2) // per base unit (default/last cost)
  sellingPrice          Decimal                 @db.Decimal(14, 2) // per base unit
  wholesalePrice        Decimal?                @db.Decimal(14, 2) // per base unit
  minStock              Decimal                 @default(0) @db.Decimal(14, 3) // in base units
  avgCost               Decimal                 @default(0) @db.Decimal(16, 4) // weighted-average cost per base unit, maintained by stock receipts
  imageUrl              String?
  status                RecordStatus            @default(ACTIVE)
  createdById           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  units                 ProductUnit[]
  balances              StockBalance[]
  movements             StockMovement[]
  receiptItems          StockReceiptItem[]
  transferItems         StockTransferItem[]
  adjustItems           StockAdjustmentItem[]
  saleItems             SaleItem[]
  image                 ProductImage?
  reversalItems         ReversalItem[]
  shipmentItems         ShipmentItem[]
  resellerIssueItems    ResellerIssueItem[]
  resellerReturnItems   ResellerReturnItem[]
  receivingItems        ShipmentReceivingItem[]
  priceHistory          ProductPriceHistory[]
  items                 InventoryItem[]
  issueDecisions        ShipmentIssueDecision[]
  issueVariantOf        ShipmentIssueDecision[] @relation("IssueVariant")
  pickupItems           PickupNoteItem[]
  pickupReleaseItems    PickupReleaseItem[]
  warehouseEvents       WarehouseEvent[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
}

// Packaging conversion: 1 <unit> = <factor> base units (e.g. 1 carton = 12 bottles => factor 12).
// Price overrides are optional; when null the price is base price x factor.
model ProductUnit {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id])
  factor         Decimal  @db.Decimal(14, 4)
  sellingPrice   Decimal? @db.Decimal(14, 2)
  wholesalePrice Decimal? @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  @@unique([productId, unitId])
  @@index([unitId])
}

// ───────────── Accountability ─────────────

// Append-only. A DB trigger (see init migration) rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userName   String? // snapshot so history stays readable
  action     String // e.g. product.update
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  reference  String? // related transaction number
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}

// ───────────── Phase 2: Inventory ─────────────

enum StockMovementType {
  RECEIVED
  SOLD
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  ADJUSTMENT
  CORRECTION
}

enum ReceiptType {
  PURCHASE
  OPENING_STOCK
}

enum AdjustmentKind {
  INCREASE
  DECREASE
  DAMAGE
  COUNT
}

model Supplier {
  id            String            @id @default(cuid())
  name          String            @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        RecordStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  receipts      StockReceipt[]
  shipments     Shipment[]
  payments      SupplierPayment[]
}

// Atomic sequence for human-readable document numbers (GRN-2026-000001, TRF-…, ADJ-…, later INV-…).
model DocumentCounter {
  key   String @id // e.g. "GRN-2026"
  value Int    @default(0)
}

// Current quantity per product per location, in BASE units. Only changed through the stock engine,
// always together with a StockMovement row. DB CHECK keeps it >= 0.
model StockBalance {
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Decimal  @default(0) @db.Decimal(14, 3) // physical stock
  reserved   Decimal  @default(0) @db.Decimal(14, 3) // sold, waiting to be collected (still physically here). Available = quantity - reserved
  updatedAt  DateTime @updatedAt

  @@id([productId, locationId])
  @@index([locationId])
}

// The stock ledger. Append-only (DB trigger). quantity is signed: + in, - out.
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  previousQty   Decimal           @db.Decimal(14, 3)
  newQty        Decimal           @db.Decimal(14, 3)
  unitCost      Decimal?          @db.Decimal(16, 4) // cost per base unit applied to this movement
  referenceType String? // StockReceipt | StockTransfer | StockAdjustment | (later) Sale …
  referenceId   String?
  referenceNo   String?
  reason        String?
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([productId, locationId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model StockReceipt {
  id              String                  @id @default(cuid())
  receiptNo       String                  @unique
  type            ReceiptType             @default(PURCHASE)
  supplierId      String?
  supplier        Supplier?               @relation(fields: [supplierId], references: [id])
  locationId      String
  location        Location                @relation(fields: [locationId], references: [id])
  supplierInvoice String?
  receivedDate    DateTime                @db.Date
  notes           String?
  totalCost       Decimal                 @db.Decimal(14, 2)
  submissionKey   String                  @unique // blocks duplicate form submissions
  receivedById    String
  receivedBy      User                    @relation(fields: [receivedById], references: [id])
  createdAt       DateTime                @default(now())
  items           StockReceiptItem[]
  inventoryItems  InventoryItem[]
  receiving       ShipmentReceiving?
  issueDecisions  ShipmentIssueDecision[]

  @@index([createdAt])
  @@index([supplierId])
}

model StockReceiptItem {
  id            String       @id @default(cuid())
  receiptId     String
  receipt       StockReceipt @relation(fields: [receiptId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  enteredQty    Decimal      @db.Decimal(14, 3) // as typed, in enteredUnit
  enteredUnitId String
  enteredUnit   Unit         @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal      @db.Decimal(14, 4) // base units per entered unit (snapshot)
  quantity      Decimal      @db.Decimal(14, 3) // base units received
  unitCost      Decimal      @db.Decimal(16, 4) // per base unit
  lineTotal     Decimal      @db.Decimal(14, 2)

  @@index([receiptId])
  @@index([productId])
}

model StockTransfer {
  id             String              @id @default(cuid())
  transferNo     String              @unique
  fromLocationId String
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  notes          String?
  submissionKey  String              @unique
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  items          StockTransferItem[]

  @@index([createdAt])
}

model StockTransferItem {
  id            String        @id @default(cuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  enteredQty    Decimal       @db.Decimal(14, 3)
  enteredUnitId String
  enteredUnit   Unit          @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal       @db.Decimal(14, 4)
  quantity      Decimal       @db.Decimal(14, 3)

  @@index([transferId])
  @@index([productId])
}

// Damage/loss reports, manual increases/decreases and stock counts. A reason is always required.
model StockAdjustment {
  id            String                @id @default(cuid())
  adjustmentNo  String                @unique
  kind          AdjustmentKind
  locationId    String
  location      Location              @relation(fields: [locationId], references: [id])
  reason        String
  submissionKey String                @unique
  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id])
  createdAt     DateTime              @default(now())
  items         StockAdjustmentItem[]

  @@index([createdAt])
  @@index([kind])
}

model StockAdjustmentItem {
  id            String          @id @default(cuid())
  adjustmentId  String
  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id])
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  enteredQty    Decimal         @db.Decimal(14, 3) // typed quantity (the counted total for COUNT)
  enteredUnitId String
  enteredUnit   Unit            @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal         @db.Decimal(14, 4)
  systemQty     Decimal         @db.Decimal(14, 3) // on hand just before the adjustment
  delta         Decimal         @db.Decimal(14, 3) // signed base-unit change actually applied
  unitCost      Decimal?        @db.Decimal(16, 4)

  @@index([adjustmentId])
  @@index([productId])
}

// ───────────── Phase 3: Customers, sales, payments ─────────────

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  BUSINESS
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
}

enum PaymentSource {
  AT_SALE
  DEBT_COLLECTION
}

// What a customer owes is NOT stored here: it is always calculated from their sales and payment
// allocations, so it can never drift out of step with the transactions.
model Customer {
  id                 String              @id @default(cuid())
  name               String
  contactPerson      String?
  phone              String?
  businessLocation   String?
  type               CustomerType        @default(RETAIL)
  creditLimit        Decimal             @default(0) @db.Decimal(14, 2) // 0 = no credit allowed
  notes              String?
  status             RecordStatus        @default(ACTIVE)
  createdById        String?
  createdBy          User?               @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now()) // account opening date
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  payments           Payment[]
  reminders          PaymentReminder[]
  reseller           Reseller?
  creditApplications CreditApplication[]

  @@index([name])
  @@index([phone])
  @@index([status])
}

// An invoice. Revenue is recognised here, once. Cash received later is a Payment, never a new Sale.
model Sale {
  id                    String              @id @default(cuid())
  saleNo                String              @unique
  customerId            String?
  customer              Customer?           @relation(fields: [customerId], references: [id])
  locationId            String
  location              Location            @relation(fields: [locationId], references: [id])
  salespersonId         String
  salesperson           User                @relation("SaleSalesperson", fields: [salespersonId], references: [id])
  status                SaleStatus          @default(COMPLETED)
  subtotal              Decimal             @db.Decimal(14, 2) // at list prices
  discountTotal         Decimal             @default(0) @db.Decimal(14, 2)
  total                 Decimal             @db.Decimal(14, 2) // subtotal - discountTotal
  amountPaid            Decimal             @default(0) @db.Decimal(14, 2) // = sum of payment allocations (money received, never reduced)
  returnedTotal         Decimal             @default(0) @db.Decimal(14, 2) // value of goods returned / cancelled (credit note)
  refundedTotal         Decimal             @default(0) @db.Decimal(14, 2) // money paid back to the customer
  paymentStatus         PaymentStatus
  dueDate               DateTime?           @db.Date
  cogsTotal             Decimal             @db.Decimal(14, 2) // cost of goods sold, snapshot at sale time
  notes                 String?
  creditApprovedById    String?
  creditApprovedBy      User?               @relation("SaleCreditApprover", fields: [creditApprovedById], references: [id])
  creditExceptionReason String?
  discountReason        String? // required whenever a discount was given
  channel               SaleChannel         @default(SHOP)
  resellerId            String?
  reseller              Reseller?           @relation(fields: [resellerId], references: [id])
  submissionKey         String              @unique
  createdAt             DateTime            @default(now())
  items                 SaleItem[]
  allocations           PaymentAllocation[]
  reversals             SaleReversal[]
  pickupNote            PickupNote?

  @@index([createdAt])
  @@index([customerId, status])
  @@index([salespersonId, createdAt])
  @@index([paymentStatus])
  @@index([locationId])
  @@index([resellerId])
}

model SaleItem {
  id            String         @id @default(cuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  enteredQty    Decimal        @db.Decimal(14, 3)
  enteredUnitId String
  enteredUnit   Unit           @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal        @db.Decimal(14, 4)
  quantity      Decimal        @db.Decimal(14, 3) // base units deducted from stock
  listPrice     Decimal        @db.Decimal(14, 2) // per entered unit, from the price list
  unitPrice     Decimal        @db.Decimal(14, 2) // per entered unit, actually charged
  discount      Decimal        @default(0) @db.Decimal(14, 2) // line total at list price - lineTotal
  lineTotal     Decimal        @db.Decimal(14, 2)
  unitCost      Decimal        @db.Decimal(16, 4) // average cost per base unit at sale time
  costTotal     Decimal        @db.Decimal(14, 2)
  reversalItems ReversalItem[]
  pickupItem    PickupNoteItem?

  @@index([saleId])
  @@index([productId])
}

// Money received. Linked to invoices through PaymentAllocation. Anything not allocated is customer credit (Phase 4).
model Payment {
  id            String              @id @default(cuid())
  paymentNo     String              @unique
  source        PaymentSource
  customerId    String?
  customer      Customer?           @relation(fields: [customerId], references: [id])
  method        PaymentMethod
  amount        Decimal             @db.Decimal(14, 2)
  reference     String? // mobile money / bank transaction reference
  notes         String?
  receivedById  String
  receivedBy    User                @relation(fields: [receivedById], references: [id])
  receivedAt    DateTime            @default(now())
  submissionKey String?             @unique // set on debt collections: blocks duplicate form submissions
  allocations   PaymentAllocation[]

  @@index([receivedAt])
  @@index([customerId])
  @@index([method, receivedAt])
}

// One slice of a payment applied to one invoice. A payment can be spread over several invoices, and the
// part of a payment that is not allocated is the customer's advance credit.
// creditApplicationId is set when the allocation uses previously unallocated credit rather than new cash.
model PaymentAllocation {
  id                  String             @id @default(cuid())
  paymentId           String
  payment             Payment            @relation(fields: [paymentId], references: [id])
  saleId              String
  sale                Sale               @relation(fields: [saleId], references: [id])
  amount              Decimal            @db.Decimal(14, 2)
  creditApplicationId String?
  creditApplication   CreditApplication? @relation(fields: [creditApplicationId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([saleId])
  @@index([creditApplicationId])
}

// Using a customer's advance credit to pay invoices. No new money arrives, so it is not a Payment.
model CreditApplication {
  id            String              @id @default(cuid())
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id])
  amount        Decimal             @db.Decimal(14, 2)
  notes         String?
  submissionKey String              @unique
  createdById   String
  createdBy     User                @relation(fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  allocations   PaymentAllocation[]

  @@index([customerId])
}

// ───────────── Product pictures & price history ─────────────

// One picture per product, stored resized in the database (no external file service needed).
// `full` is for the product page, `thumb` for POS cards. Served through /api/product-image/[id].
model ProductImage {
  productId   String   @id
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mime        String
  full        Bytes
  thumb       Bytes
  width       Int
  height      Int
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

// Every change to a product's prices, newest last. Past sales keep their own price snapshots.
model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  field       String // sellingPrice | wholesalePrice | purchasePrice | unitSellingPrice | unitWholesalePrice
  unitLabel   String? // packaging unit symbol for unit prices
  oldValue    Decimal? @db.Decimal(14, 2)
  newValue    Decimal? @db.Decimal(14, 2)
  changedById String?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

// ───────────── Phase 5: returns, cancellations, notifications ─────────────

enum ReversalKind {
  CANCEL // the whole sale is undone
  RETURN // some items come back
}

enum ReversalStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ReturnCondition {
  RESELLABLE // goes back on the shelf
  DAMAGED // comes back but is written off, never returns to sellable stock
}

// A return or cancellation. The original sale is never edited: it gets credit-note totals
// (Sale.returnedTotal / refundedTotal) and this record explains why. PENDING until a manager approves.
model SaleReversal {
  id              String         @id @default(cuid())
  reversalNo      String         @unique
  saleId          String
  sale            Sale           @relation(fields: [saleId], references: [id])
  kind            ReversalKind
  status          ReversalStatus @default(PENDING)
  reason          String
  refundMethod    PaymentMethod? // how any money goes back to the customer
  refundReference String?
  returnValue     Decimal        @default(0) @db.Decimal(14, 2) // value of goods returned, set when completed
  refundAmount    Decimal        @default(0) @db.Decimal(14, 2) // money actually paid back, set when completed
  requestedById   String
  requestedBy     User           @relation("ReversalRequester", fields: [requestedById], references: [id])
  requestedAt     DateTime       @default(now())
  decidedById     String?
  decidedBy       User?          @relation("ReversalDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionNote    String?
  submissionKey   String         @unique
  items           ReversalItem[]

  @@index([saleId])
  @@index([status, requestedAt])
}

model ReversalItem {
  id          String          @id @default(cuid())
  reversalId  String
  reversal    SaleReversal    @relation(fields: [reversalId], references: [id])
  saleItemId  String
  saleItem    SaleItem        @relation(fields: [saleItemId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  enteredQty  Decimal         @db.Decimal(14, 3) // in the unit it was sold in
  factor      Decimal         @db.Decimal(14, 4)
  quantity    Decimal         @db.Decimal(14, 3) // base units
  condition   ReturnCondition
  returnValue Decimal         @default(0) @db.Decimal(14, 2) // price charged for these units, set when completed
  costValue   Decimal         @default(0) @db.Decimal(14, 2) // cost restored to stock (0 when damaged), set when completed

  @@index([reversalId])
  @@index([saleItemId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // e.g. reversal.requested
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ───────────── Phase 5b: incoming shipments and the receiving document ─────────────
//
// The OWNER announces stock that is on its way (Shipment). Nothing changes in inventory.
// The SHOP counts it on a receiving document (ShipmentReceiving): editable as a DRAFT, then CONFIRMED,
// which is the only moment stock increases. Damaged / missing / unexpected goods are flagged for the owner.

enum ShipmentStatus {
  EXPECTED // announced, nothing counted yet
  PARTIAL // some of it counted, more still to come
  RECEIVED // everything accounted for, or the shop closed it as "nothing more is coming"
  CANCELLED
}

enum ShipmentIssue {
  NONE
  OPEN // damaged / missing / extra goods: the owner must look into it
  RESOLVED
}

enum ReceivingStatus {
  DRAFT
  CONFIRMED
}

model Shipment {
  id                String                  @id @default(cuid())
  shipmentNo        String                  @unique
  supplierId        String?
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])
  reference         String? // tracking number / container / supplier invoice (older shipments; the form now asks for the cargo company)
  cargoName         String? // the cargo company that brings the goods
  expectedDate      DateTime?               @db.Date
  locationId        String
  location          Location                @relation(fields: [locationId], references: [id])
  notes             String?
  status            ShipmentStatus          @default(EXPECTED)
  issue             ShipmentIssue           @default(NONE)
  resolutionNote    String?
  resolvedById      String?
  resolvedBy        User?                   @relation("ShipmentResolver", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  arrivedAt         DateTime? // the shop pressed "Mark as arrived": counting can only start after this
  arrivedById       String?
  arrivedBy         User?                   @relation("ShipmentArriver", fields: [arrivedById], references: [id])
  closedAt          DateTime? // set when the shop says nothing more is coming
  closedById        String?
  closedBy          User?                   @relation("ShipmentCloser", fields: [closedById], references: [id])
  createdById       String
  createdBy         User                    @relation("ShipmentCreator", fields: [createdById], references: [id])
  submissionKey     String                  @unique
  createdAt         DateTime                @default(now())
  items             ShipmentItem[]
  receivings        ShipmentReceiving[]
  supplierPayments  SupplierPayment[]
  inventoryItems    InventoryItem[]
  issueDecisions    ShipmentIssueDecision[] @relation("IssueShipment")
  issueReplacements ShipmentIssueDecision[] @relation("IssueMovedTo")

  @@index([status, createdAt])
  @@index([issue])
}

model ShipmentItem {
  id             String                  @id @default(cuid())
  shipmentId     String
  shipment       Shipment                @relation(fields: [shipmentId], references: [id])
  productId      String
  product        Product                 @relation(fields: [productId], references: [id])
  expectedQty    Decimal                 @db.Decimal(14, 3) // base units; 0 for goods the shop found that were not announced
  enteredQty     Decimal                 @db.Decimal(14, 3) // as the owner typed it, in enteredUnit
  enteredUnitId  String
  enteredUnit    Unit                    @relation(fields: [enteredUnitId], references: [id])
  factor         Decimal                 @db.Decimal(14, 4)
  unitCost       Decimal?                @db.Decimal(16, 4) // landed cost per base unit, set by the owner (hidden from the shop)
  lineCost       Decimal?                @db.Decimal(14, 2)
  unexpected     Boolean                 @default(false)
  missingQty     Decimal                 @default(0) @db.Decimal(14, 3) // filled in when the shipment is closed
  sellingPrice   Decimal?                @db.Decimal(14, 2) // new selling price per base unit the owner entered with the shipment; null = no change
  wholesalePrice Decimal?                @db.Decimal(14, 2) // same, wholesale
  priceAppliedAt DateTime? // the new prices go live when this line's stock is first counted in
  receivingItems ShipmentReceivingItem[]
  issueDecisions ShipmentIssueDecision[]

  @@unique([shipmentId, productId])
  @@index([productId])
}

// What the owner decided about a problem product of a received shipment (missing, damaged, extra). Append-only: a decision is never edited.
enum IssueKind {
  MISSING
  DAMAGED
  EXTRA
}

enum IssueAction {
  FOUND // missing pieces turned up: they go into stock now (a normal receipt, tied to the shipment)
  NOT_DELIVERED // the supplier never delivered them: a shortage (optionally carried to a new order); no stock is added
  WRITE_OFF // damaged pieces cannot be sold: they are thrown away for good
  KEEP // extra pieces are accepted
  DISCOUNT_SELL // damaged pieces can be sold, at a lower price, as a separate "damaged packaging" product
  DISMISS // removed from the list without changing stock or money (a reason is always kept)
}

model ShipmentIssueDecision {
  id                String        @id @default(cuid())
  shipmentId        String
  shipment          Shipment      @relation("IssueShipment", fields: [shipmentId], references: [id])
  shipmentItemId    String
  shipmentItem      ShipmentItem  @relation(fields: [shipmentItemId], references: [id])
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  kind              IssueKind
  action            IssueAction
  quantity          Decimal       @db.Decimal(14, 3)
  note              String?
  stockReceiptId    String? // set when pieces were found and received
  stockReceipt      StockReceipt? @relation(fields: [stockReceiptId], references: [id])
  movedToShipmentId String? // set when a shortage was carried to a new purchase order
  movedToShipment   Shipment?     @relation("IssueMovedTo", fields: [movedToShipmentId], references: [id])
  discountPrice     Decimal?      @db.Decimal(14, 2) // per base unit (piece) for DISCOUNT_SELL
  variantProductId  String? // the "damaged packaging" product the pieces were moved into
  variantProduct    Product?      @relation("IssueVariant", fields: [variantProductId], references: [id])
  submissionKey     String        @unique // blocks a double submit
  decidedById       String
  decidedBy         User          @relation("IssueDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime      @default(now())

  @@index([shipmentId])
  @@index([shipmentItemId])
}

model ShipmentReceiving {
  id             String                  @id @default(cuid())
  shipmentId     String
  shipment       Shipment                @relation(fields: [shipmentId], references: [id])
  sessionNo      Int
  status         ReceivingStatus         @default(DRAFT)
  notes          String?
  finishShipment Boolean                 @default(false) // "nothing more is coming"
  startedById    String
  startedBy      User                    @relation("ReceivingStarter", fields: [startedById], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  confirmedById  String?
  confirmedBy    User?                   @relation("ReceivingConfirmer", fields: [confirmedById], references: [id])
  confirmedAt    DateTime?
  stockReceiptId String?                 @unique
  stockReceipt   StockReceipt?           @relation(fields: [stockReceiptId], references: [id])
  items          ShipmentReceivingItem[]

  @@unique([shipmentId, sessionNo])
}

model ShipmentReceivingItem {
  id             String            @id @default(cuid())
  receivingId    String
  receiving      ShipmentReceiving @relation(fields: [receivingId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  shipmentItemId String? // null = goods that were not announced
  shipmentItem   ShipmentItem?     @relation(fields: [shipmentItemId], references: [id])
  enteredUnitId  String
  enteredUnit    Unit              @relation(fields: [enteredUnitId], references: [id])
  factor         Decimal           @db.Decimal(14, 4)
  enteredGood    Decimal           @db.Decimal(14, 3)
  enteredDamaged Decimal           @db.Decimal(14, 3)
  goodQty        Decimal           @db.Decimal(14, 3) // base units in good condition
  damagedQty     Decimal           @db.Decimal(14, 3) // base units damaged on arrival
  note           String?

  @@index([receivingId])
  @@index([shipmentItemId])
}

// ───────────── Cash, expenses, deposits and daily closing ─────────────

// One account per payment method per location. Cash = physical money in the till; mobile money and the bank are
// separate balances and are never mixed with it. The balance is always the sum of the ledger, never stored.
// A place money sits: the till, or one mobile-money / bank account (CRDB, NMB, M-PESA, ...). A location has ONE cash
// account (the till) and as many mobile-money and bank accounts as the owner adds. Exactly one account per method is the
// default, used when a flow does not name an account (the DB guards both rules).
model CashAccount {
  id            String            @id @default(cuid())
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  method        PaymentMethod
  name          String
  accountNumber String? // bank account number, mobile-money number, lipa number...
  holderName    String? // the name the account is registered in
  status        RecordStatus      @default(ACTIVE) // a closed account keeps its history but cannot be chosen any more
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  transactions  CashTransaction[]
  expenses      Expense[]

  @@index([locationId, method])
}

enum CashTxType {
  SALE_PAYMENT // money taken at a sale
  COLLECTION // a customer paid a debt (or advance credit)
  REFUND // money paid back to a customer
  EXPENSE
  EXPENSE_REVERSAL
  SUPPLIER_PAYMENT // money paid to a supplier
  DEPOSIT_OUT // cash leaves the till for the bank (a transfer, not an expense)
  DEPOSIT_IN // the same money arriving in the bank account
  WITHDRAWAL // the owner takes money out
  ADJUSTMENT // an authorised correction
  OPENING_BALANCE // money that was already there when the system started
  CLOSING_DIFFERENCE // counted cash minus expected cash, booked when a day is closed
  TRANSFER_OUT // the owner moved money out of this account into another of the shop's accounts
  TRANSFER_IN // the same money arriving in the other account
}

// The append-only cash ledger. Signed amount (+ in, - out). Every row comes from a source record written in the same
// database transaction, and (account, type, source) is unique so nothing can be counted twice. A row may belong to
// at most one daily closing (closingId is set once, by that closing).
model CashTransaction {
  id            String        @id @default(cuid())
  accountId     String
  account       CashAccount   @relation(fields: [accountId], references: [id])
  type          CashTxType
  amount        Decimal       @db.Decimal(14, 2)
  businessDate  DateTime      @db.Date
  referenceType String
  referenceId   String
  referenceNo   String?
  description   String?
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
  closingId     String?
  closing       DailyClosing? @relation(fields: [closingId], references: [id])

  @@unique([accountId, type, referenceType, referenceId])
  @@index([accountId, closingId])
  @@index([businessDate])
  @@index([type, businessDate])
}

model ExpenseCategory {
  id            String       @id @default(cuid())
  name          String       @unique
  approvalLimit Decimal?     @db.Decimal(14, 2) // overrides the general limit for this category
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  expenses      Expense[]
}

enum ExpenseStatus {
  PENDING // above the limit: waiting for the owner, no money has moved
  APPROVED // within the limit, or approved: the money has left the account
  REJECTED
  REVERSED // approved earlier, then cancelled by an authorised person: the money is put back
}

model Expense {
  id             String          @id @default(cuid())
  expenseNo      String          @unique
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  description    String
  amount         Decimal         @db.Decimal(14, 2)
  method         PaymentMethod // which account the money comes from
  cashAccountId  String? // the exact account (CRDB, M-PESA...) the money comes from
  cashAccount    CashAccount?    @relation(fields: [cashAccountId], references: [id])
  expenseDate    DateTime        @db.Date
  notes          String?
  receiptId      String?
  receipt        Attachment?     @relation(fields: [receiptId], references: [id])
  status         ExpenseStatus
  locationId     String
  location       Location        @relation(fields: [locationId], references: [id])
  requestedById  String
  requestedBy    User            @relation("ExpenseRequester", fields: [requestedById], references: [id])
  requestedAt    DateTime        @default(now())
  decidedById    String?
  decidedBy      User?           @relation("ExpenseDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  reversedById   String?
  reversedBy     User?           @relation("ExpenseReverser", fields: [reversedById], references: [id])
  reversedAt     DateTime?
  reversalReason String?
  submissionKey  String          @unique

  @@index([status, requestedAt])
  @@index([expenseDate])
  @@index([requestedById, requestedAt])
}

// A small picture (receipt, deposit slip) stored resized in the database, like product pictures.
model Attachment {
  id          String        @id @default(cuid())
  kind        String // EXPENSE_RECEIPT | DEPOSIT_SLIP
  mime        String
  data        Bytes
  sizeBytes   Int
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  expenses    Expense[]
  deposits    BankDeposit[]
}

model BankDeposit {
  id            String      @id @default(cuid())
  depositNo     String      @unique
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  amount        Decimal     @db.Decimal(14, 2)
  bankReference String
  notes         String?
  slipId        String?
  slip          Attachment? @relation(fields: [slipId], references: [id])
  businessDate  DateTime    @db.Date
  closingId     String? // set when the deposit was made as part of a daily closing
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  submissionKey String      @unique

  @@index([businessDate])
}

enum ClosingStatus {
  SUBMITTED // within the allowed difference
  NEEDS_REVIEW // the count differed by more than the allowed amount: the owner must look at it
  REVIEWED // the owner has looked at it and signed it off
}

// One per location per business day. Once submitted it is locked: the figures are a snapshot and never change;
// corrections are new, authorised cash adjustments.
model DailyClosing {
  id            String            @id @default(cuid())
  closingNo     String            @unique
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  businessDate  DateTime          @db.Date
  openingCash   Decimal           @db.Decimal(14, 2)
  expectedCash  Decimal           @db.Decimal(14, 2)
  countedCash   Decimal           @db.Decimal(14, 2)
  difference    Decimal           @db.Decimal(14, 2) // counted - expected (negative = shortage)
  depositedNow  Decimal           @default(0) @db.Decimal(14, 2) // deposited to the bank as part of this closing
  cashCarried   Decimal           @db.Decimal(14, 2) // cash left in the till = counted - depositedNow
  summary       Json // the full day summary exactly as the attendant saw it
  notes         String?
  status        ClosingStatus
  submittedById String
  submittedBy   User              @relation("ClosingSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime          @default(now())
  reviewedById  String?
  reviewedBy    User?             @relation("ClosingReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  submissionKey String            @unique
  transactions  CashTransaction[]

  @@unique([locationId, businessDate])
  @@index([status])
}

// ───────────── Resellers / consignment ─────────────
// A reseller takes stock to sell elsewhere. ISSUING is a custody transfer (shop -> the reseller's own RESELLER location):
// no sale, no cash, no receivable. When the reseller REPORTS what was sold, a normal credit invoice (channel RESELLER) is
// created against the reseller's customer account, taking the stock from custody. Money brought in is an ordinary
// payment allocated to those invoices. Revenue is recognised once, at the sold report.

enum SaleChannel {
  SHOP
  RESELLER
}

model Reseller {
  id             String           @id @default(cuid())
  name           String
  businessName   String?
  phone          String
  altPhone       String?
  address        String?
  salesLocation  String? // where they sell
  idInfo         String? // ID / licence number (optional)
  notes          String?
  settlementDays Int              @default(14) // how long after a sold report the money is due
  status         RecordStatus     @default(ACTIVE)
  customerId     String           @unique // the account that holds their invoices and payments
  customer       Customer         @relation(fields: [customerId], references: [id])
  locationId     String           @unique // where their stock is kept (custody)
  location       Location         @relation(fields: [locationId], references: [id])
  registeredAt   DateTime         @default(now())
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  issues         ResellerIssue[]
  returns        ResellerReturn[]
  sales          Sale[]
}

model ResellerIssue {
  id             String              @id @default(cuid())
  issueNo        String              @unique
  resellerId     String
  reseller       Reseller            @relation(fields: [resellerId], references: [id])
  fromLocationId String
  fromLocation   Location            @relation("IssueFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location            @relation("IssueTo", fields: [toLocationId], references: [id])
  expectedValue  Decimal             @db.Decimal(14, 2) // what the stock is worth at the agreed prices
  notes          String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  submissionKey  String              @unique
  items          ResellerIssueItem[]

  @@index([resellerId, createdAt])
}

model ResellerIssueItem {
  id            String        @id @default(cuid())
  issueId       String
  issue         ResellerIssue @relation(fields: [issueId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  enteredQty    Decimal       @db.Decimal(14, 3)
  enteredUnitId String
  enteredUnit   Unit          @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal       @db.Decimal(14, 4)
  quantity      Decimal       @db.Decimal(14, 3) // base units
  unitPrice     Decimal       @db.Decimal(14, 2) // agreed price per ENTERED unit, snapshot
  basePrice     Decimal       @db.Decimal(14, 4) // agreed price per BASE unit (what later sold reports are charged at)
  lineValue     Decimal       @db.Decimal(14, 2)

  @@index([issueId])
  @@index([productId])
}

model ResellerReturn {
  id             String               @id @default(cuid())
  returnNo       String               @unique
  resellerId     String
  reseller       Reseller             @relation(fields: [resellerId], references: [id])
  fromLocationId String
  fromLocation   Location             @relation("ReturnFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location             @relation("ReturnTo", fields: [toLocationId], references: [id])
  notes          String?
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  submissionKey  String               @unique
  items          ResellerReturnItem[]

  @@index([resellerId, createdAt])
}

model ResellerReturnItem {
  id            String          @id @default(cuid())
  returnId      String
  return        ResellerReturn  @relation(fields: [returnId], references: [id])
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  enteredQty    Decimal         @db.Decimal(14, 3)
  enteredUnitId String
  enteredUnit   Unit            @relation(fields: [enteredUnitId], references: [id])
  factor        Decimal         @db.Decimal(14, 4)
  quantity      Decimal         @db.Decimal(14, 3)
  condition     ReturnCondition

  @@index([returnId])
}

// ───────────── WhatsApp daily reports (CallMeBot) ─────────────
// One row per message sent (or to be sent). Scheduled reports are unique per day/kind/part, so the scheduler can run
// as often as it likes and never sends the same report twice. Message text is kept so a failed part can be retried
// exactly as it was, and so the owner can see what was sent.

enum ReportKind {
  SUMMARY
  DETAIL
  EXCEPTION // the shop has not closed the day
  WEEKLY // the business report of a week (sent after the Sunday closing)
  MONTHLY // the business report of a month (sent after the closing of its last day)
}

enum ReportTrigger {
  SCHEDULED
  MANUAL
}

enum ReportStatus {
  PENDING
  SENDING // claimed by one running job, so two jobs can never send the same message
  SENT
  FAILED
}

model WhatsAppReport {
  id            String        @id @default(cuid())
  businessDate  DateTime      @db.Date
  kind          ReportKind
  part          Int // 1-based; the summary is part 1 of 1
  parts         Int
  trigger       ReportTrigger
  status        ReportStatus  @default(PENDING)
  attempts      Int           @default(0)
  error         String?
  content       String
  toPhone       String // the number, masked for display in the log
  requestedById String?
  createdAt     DateTime      @default(now())
  sentAt        DateTime?
  claimedAt     DateTime?

  @@index([businessDate, kind])
  @@index([status, createdAt])
}

// An automatic WhatsApp payment reminder to a customer. At most one per customer per day: the row is created BEFORE
// sending, so two jobs can never message the same person twice. Manual reminders (opened in WhatsApp by staff) are in the audit log.
model PaymentReminder {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  businessDate  DateTime      @db.Date
  trigger       ReportTrigger
  status        ReportStatus  @default(SENDING)
  attempts      Int           @default(0)
  error         String?
  saleIds       Json // the invoices this message was about
  totalOwed     Decimal       @db.Decimal(14, 2)
  toPhone       String // masked for display
  providerId    String? // WhatsApp's id for the message
  requestedById String?
  createdAt     DateTime      @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?

  @@unique([customerId, businessDate])
  @@index([status, createdAt])
  @@index([createdAt])
}

// Money paid to a supplier (from cash, mobile money or the bank). What we owe a supplier is always calculated:
// the cost of their shipments and purchase receipts minus these payments.
model SupplierPayment {
  id            String        @id @default(cuid())
  paymentNo     String        @unique
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  shipmentId    String? // the shipment this payment is for, when it is for one
  shipment      Shipment?     @relation(fields: [shipmentId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  reference     String?
  notes         String?
  locationId    String
  paidAt        DateTime      @default(now())
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  submissionKey String        @unique

  @@index([supplierId, paidAt])
}

// ───────────── Individual items (every physical unit has its own identity) ─────────────

// Where one physical piece stands. Changes only together with an ItemMovement (a database trigger enforces it).
enum ItemStatus {
  AVAILABLE // in the shop (or another normal location), can be sold
  SOLD
  WITH_RESELLER // in a reseller's custody
  DAMAGED
  MISSING // counted as lost
  DISPOSED // a damaged piece that was thrown away
}

enum ItemEventKind {
  RECEIVED
  ADDED // found stock added by an adjustment
  SOLD
  RETURNED // came back from a customer
  TRANSFERRED
  ISSUED_TO_RESELLER
  RETURNED_FROM_RESELLER
  SOLD_BY_RESELLER
  DAMAGED
  MISSING
  RESTORED // a damaged piece put back into stock (needs authorisation)
  DISPOSED
}

// One row per physical piece of a product whose base unit is a whole number (bottles, gallons, boxes).
// itemNo is the short number printed on the label; token is the secret-free random reference inside the QR code.
// Neither ever changes or is reused. Created when stock is received, never by hand.
model InventoryItem {
  id             String         @id @default(cuid())
  itemNo         String         @unique // SDO-ITEM-000001
  token          String         @unique // random, not guessable; this is what the QR code carries
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id])
  status         ItemStatus     @default(AVAILABLE)
  receivedAt     DateTime       @default(now())
  receiptId      String?
  receipt        StockReceipt?  @relation(fields: [receiptId], references: [id])
  shipmentId     String?
  shipment       Shipment?      @relation(fields: [shipmentId], references: [id])
  saleId         String? // the sale it was last sold on
  saleItemId     String?
  lastMovementId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  movements      ItemMovement[]

  @@index([productId, locationId, status, receivedAt, itemNo])
  @@index([status])
  @@index([shipmentId])
  @@index([receiptId])
  @@index([saleItemId])
  @@index([saleId])
}

// The history of an item. Append-only (database trigger): nothing here is ever edited or deleted.
model ItemMovement {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  kind           ItemEventKind
  fromStatus     ItemStatus?
  toStatus       ItemStatus
  fromLocationId String?
  toLocationId   String
  referenceType  String?
  referenceId    String?
  referenceNo    String?
  note           String?
  auto           Boolean       @default(false) // picked by the system because the sale/adjustment was by quantity, not by scanning this piece
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([itemId, createdAt])
}


// ───────────── Store Warehouse: reservations, pickup notes, collection ─────────────

enum PickupStatus {
  NEW // sold, waiting for the warehouse
  PREPARING // the attendant started picking the goods
  READY // goods set aside, waiting to be collected
  PARTIAL // some goods collected, the rest is still reserved
  COMPLETED // everything collected (terminal)
  CANCELLED // sale cancelled before anything was collected (terminal)
}

enum PickupAuth {
  PAID // fully paid
  PART_PAID // part paid, the rest on authorised credit
  CREDIT_APPROVED // on credit that passed the credit rules (limit or approved exception)
}

// The document that lets goods leave the warehouse. One per sale made from a pickup location. The QR code carries only `token`;
// everything else is looked up on the server after the scan.
model PickupNote {
  id            String       @id @default(cuid())
  noteNo        String       @unique // PU-2026-000125
  token         String       @unique // random, not guessable; QR text is SDOPU:<token>
  saleId        String       @unique
  sale          Sale         @relation(fields: [saleId], references: [id])
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id])
  status        PickupStatus @default(NEW)
  auth          PickupAuth
  createdById   String
  createdBy     User         @relation("PickupCreator", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  startedById   String?
  startedBy     User?        @relation("PickupStarter", fields: [startedById], references: [id])
  startedAt     DateTime?
  readyById     String?
  readyBy       User?        @relation("PickupReadier", fields: [readyById], references: [id])
  readyAt       DateTime?
  completedById String?
  completedBy   User?        @relation("PickupCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?
  cancelledById String?
  cancelledBy   User?        @relation("PickupCanceller", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?
  items         PickupNoteItem[]
  releases      PickupRelease[]
  events        WarehouseEvent[]

  @@index([status, createdAt])
  @@index([locationId, status])
  @@index([createdAt])
}

// One line of a pickup note = one invoice line. Reserved = quantity - releasedQty - cancelledQty (all in base units).
model PickupNoteItem {
  id           String     @id @default(cuid())
  noteId       String
  note         PickupNote @relation(fields: [noteId], references: [id])
  saleItemId   String     @unique
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(14, 3)
  releasedQty  Decimal    @default(0) @db.Decimal(14, 3)
  cancelledQty Decimal    @default(0) @db.Decimal(14, 3) // reservation given back because the sale was cancelled / returned before collection
  releaseItems PickupReleaseItem[]

  @@index([noteId])
  @@index([productId])
}

// A goods collection record: who released what, when. Append-only (database trigger).
model PickupRelease {
  id            String     @id @default(cuid())
  releaseNo     String     @unique // COL-2026-000001
  noteId        String
  note          PickupNote @relation(fields: [noteId], references: [id])
  releasedById  String
  releasedBy    User       @relation(fields: [releasedById], references: [id])
  collectedBy   String? // who took the goods (name), optional
  remark        String?
  submissionKey String     @unique // blocks a double submit
  createdAt     DateTime   @default(now())
  items         PickupReleaseItem[]

  @@index([noteId])
  @@index([releasedById, createdAt])
}

model PickupReleaseItem {
  id         String         @id @default(cuid())
  releaseId  String
  release    PickupRelease  @relation(fields: [releaseId], references: [id])
  noteItemId String
  noteItem   PickupNoteItem @relation(fields: [noteItemId], references: [id])
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  quantity   Decimal        @db.Decimal(14, 3)

  @@index([releaseId])
  @@index([noteItemId])
}

enum WarehouseEventType {
  RESERVED // stock set aside for a sale
  PREPARING // attendant started picking
  READY // goods set aside for collection
  RELEASED // goods handed over, physical stock deducted
  RESERVATION_FREED // reservation given back (sale cancelled or returned before collection)
  SCAN_REJECTED // a pickup note was refused at the scanner
}

// The warehouse activity log. Append-only (database trigger). Stock quantities themselves are in StockMovement; this records
// the reservation side (previous / new reserved) and who did what at the warehouse.
model WarehouseEvent {
  id               String             @id @default(cuid())
  type             WarehouseEventType
  locationId       String?
  location         Location?          @relation(fields: [locationId], references: [id])
  productId        String?
  product          Product?           @relation(fields: [productId], references: [id])
  quantity         Decimal?           @db.Decimal(14, 3)
  previousReserved Decimal?           @db.Decimal(14, 3)
  newReserved      Decimal?           @db.Decimal(14, 3)
  pickupNoteId     String?
  pickupNote       PickupNote?        @relation(fields: [pickupNoteId], references: [id])
  detail           String?
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  createdAt        DateTime           @default(now())

  @@index([pickupNoteId, createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}
